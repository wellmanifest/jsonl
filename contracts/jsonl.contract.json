{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "wellmanifest.jsonl/contract-bundle/v1",
  "version": "0.1.0",
  "mediaType": "application/x-ndjson",
  "encoding": "UTF-8",
  "lineEnding": "LF",
  "maxLineBytes": 1048576,
  "canonicalization": "wellmanifest-canonical-json-v1",
  "hashAlgorithm": "SHA-256",
  "candidateSchemaRef": "https://wellmanifest.com/schemas/jsonl/candidate.v1.json",
  "recordSchemaRef": "https://wellmanifest.com/schemas/jsonl/record.v1.json",
  "generationRequestSchemaRef": "https://wellmanifest.com/schemas/jsonl/generation-request.v1.json",
  "rules": {
    "oneObjectPerLine": true,
    "blankLines": "forbidden",
    "byteOrderMark": "forbidden",
    "finalLineFeed": "required",
    "duplicateObjectKeys": "forbidden",
    "topLevelValues": "object-only",
    "sequence": "contiguous-from-one",
    "unknownEnvelopeFields": "forbidden",
    "payloadSemantics": "external-dsl-manifest",
    "modelAuthority": "propose-only"
  },
  "runtimeOwnedFields": [
    "recordId",
    "producer",
    "occurredAt",
    "inputHash",
    "previousHash",
    "recordHash",
    "receiptRef"
  ],
  "generationRequest": {
    "required": ["schema", "targetDsl", "sourceDigest", "maxRecords"],
    "schemaValue": "wellmanifest.jsonl/generation-request/v1",
    "naturalLanguage": "forbidden",
    "authority": "propose-only"
  },
  "candidate": {
    "required": ["schema", "recordType", "sequence", "dsl", "correlationId", "payload"],
    "schemaValue": "wellmanifest.jsonl/candidate/v1"
  },
  "record": {
    "required": [
      "schema", "recordId", "recordType", "sequence", "dsl",
      "correlationId", "payload", "producer", "occurredAt", "inputHash",
      "previousHash", "recordHash", "receiptRef"
    ],
    "schemaValue": "wellmanifest.jsonl/record/v1",
    "hashExcludes": ["recordHash"]
  },
  "dslBinding": {
    "required": ["manifestId", "schemaRef", "grammarRef"],
    "authority": "The referenced DSL validates payload semantics but does not grant execution authority.",
    "autogrammarAdapter": {
      "repositoryPattern": "^https://github.com/autogrammar/[a-z0-9][a-z0-9-]*$",
      "revisionPattern": "^[a-f0-9]{40}$",
      "policy": "An adapter is advisory until its exact revision, input schema and output DSL manifest are independently validated."
    }
  }
}
