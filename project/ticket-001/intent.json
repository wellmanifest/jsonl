      "maxImplementationFiles": 9,
      "maxAffectedComponents": 3,
      "maxPublicInterfaceChanges": 2,
      "maxRuntimeDependencies": 0
    },
    "architecture": {
      "status": "accepted",
      "decision": "Use a closed candidate envelope for LLM output, a separate runtime-sealed hash-chain envelope, UTF-8/LF one-object-per-line framing and a wellmanifest/dsl manifest with digest-bound autogrammar adapter declarations.",
      "components": [
        {"name": "repository-governance", "paths": [".governance/manifest.json", ".governance/required-checks.json", ".github/workflows/ci.yml"]},
        {"name": "jsonl-contract", "paths": ["contracts/**", "grammars/**", "profiles/**"]},
        {"name": "conformance", "paths": ["standard/**", "examples/**"]}
      ],
      "responsibilityChanges": true,
      "interfaceChanges": [
        "Introduce wellmanifest.jsonl/candidate/v1 and wellmanifest.jsonl/record/v1"
      ],
      "dataChanges": [
        "Introduce canonical UTF-8 JSONL framing and SHA-256 predecessor chaining"
      ],
